{
  "name": "look-up",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@types/jest": "30.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "^58.0.0",
    "expo-image-picker": "~58.0.10",
    "expo-status-bar": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-test-renderer": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"tests/**/*.test.js\"",
    "test:components": "jest --ci",
    "bundle:check": "expo export --platform android --platform ios --output-dir .bundle-check",
    "check": "npm run typecheck && npm run lint && npm test && npm run bundle:check"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.tsx"
    ]
  }
}
