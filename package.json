{
  "name": "look-up",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"tests/**/*.test.js\"",
    "test:components": "jest --ci",
    "bundle:check": "expo export --platform android --platform ios --output-dir .bundle-check",
    "check": "npm run typecheck && npm run lint && npm test && npm run bundle:check"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.tsx"
    ]
  }
}
