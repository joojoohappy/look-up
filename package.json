{
  "name": "look-up",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"tests/**/*.test.js\"",
    "bundle:check": "expo export --platform android --platform ios --output-dir .bundle-check",
    "check": "npm run typecheck && npm test && npm run bundle:check"
  }
}
